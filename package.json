{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && vite build --config vite.seller.config.js && node scripts/ensure-exp-vendedor-logo-transparency.mjs && node scripts/generate-exp-vendedor-android-assets.mjs && node scripts/prepare-capacitor-shell.mjs",
        "dev": "concurrently -n web,seller -c blue,magenta \"vite\" \"vite build --config vite.seller.config.js --watch\"",
        "build:web": "vite build",
        "build:seller": "vite build --config vite.seller.config.js",
        "cap:sync": "npm run build && npx cap sync",
        "cap:android": "npx cap sync android",
        "cap:open:android": "npx cap open android"
    },
    "dependencies": {
        "@capacitor/android": "^7.4.3",
        "@capacitor/core": "^7.4.3",
        "@capacitor/geolocation": "^7.1.8",
        "@capacitor/ios": "^7.4.3",
        "leaflet": "1.9.4",
        "leaflet.gridlayer.googlemutant": "0.14.1",
        "leaflet.markercluster": "1.5.3",
        "lucide": "0.469.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^7.4.3",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "sharp": "^0.34.5",
        "vite": "^7.0.7"
    }
}
