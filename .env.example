APP_NAME="Expandor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Produção (ver também deploy/.env.example.production):
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://seu-dominio.com
# LOG_LEVEL=warning
# QUEUE_CONNECTION=database   # ou redis + worker: php artisan queue:work
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# SESSION_ENCRYPT=true

# Display / business timezone (IANA). Storage timestamps remain UTC.
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=geosales_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Produção: FILESYSTEM_DISK=public (e php artisan storage:link)
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@geosales.local"
MAIL_FROM_NAME="${APP_NAME}"
# Produção (SMTP platform-managed / Expandor — NÃO tenant):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.seuprovider.com
# MAIL_PORT=587
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# MAIL_SCHEME=null          # ou "smtps" na porta 465
# MAIL_FROM_ADDRESS="noreply@seudominio.com"
# MAIL_FROM_NAME="Expandor"
# Local/testing: log | array | smtp de sandbox. Produção: SMTP transacional confiável.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOGIN_DECAY_SECONDS=60
SECURITY_API_MAX_ATTEMPTS=60
SECURITY_API_DECAY_SECONDS=60
SECURITY_EXPORT_DISK=local
SECURITY_EXPORT_EXPIRES_HOURS=24

# Trial / aquisição
ACQUISITION_TRIAL_DAYS=2

PAYMENT_PROVIDER=mercadopago
PAYMENT_ALLOW_FAKE=
PAYMENT_CURRENCY=BRL
PAYMENT_TRIAL_DAYS=0
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_TOKEN=
MERCADO_PAGO_WEBHOOK_TOKEN=
MERCADO_PAGO_TIMEOUT=30
STRIPE_KEY=
STRIPE_SECRET=
FAKE_PAYMENT_WEBHOOK_TOKEN=fake-webhook-token

# Cron sugerido (produção):
# * * * * * cd /path && php artisan schedule:run >> /dev/null 2>&1
